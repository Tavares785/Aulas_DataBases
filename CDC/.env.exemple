# PostgreSQL Configuration
POSTGRES_USER=cdc_user
POSTGRES_PASSWORD=cdc_pass
POSTGRES_DB=oltp_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_TOPICS=cdc.public.users,cdc.public.orders,cdc.public.products
KAFKA_GROUP_ID=cdc-consumer-group

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Debezium Configuration
DEBEZIUM_HOST=localhost
DEBEZIUM_PORT=8083
DEBEZIUM_CONNECTOR_NAME=postgres-cdc-connector
DEBEZIUM_PLUGIN=pgoutput
DEBEZIUM_PUBLICATION=cdc_publication
DEBEZIUM_SLOT=debezium_slot